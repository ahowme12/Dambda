# terraform.tfvars
# 이 파일을 복사해서 terraform.tfvars로 만들고 값을 채워넣기 (terraform.tfvars는 gitignore됨)
aws_region      = "ap-northeast-2"
region_name     = "my-app-dev"
vpc_cidr        = "10.0.0.0/16"
public_subnets  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnets = ["10.0.10.0/24", "10.0.11.0/24"]
container_port  = 80

# 미국(us-east-1) 리전
us_aws_region      = "us-east-1"
us_region_name     = "my-app-dev-us"
us_vpc_cidr        = "10.1.0.0/16"
us_public_subnets  = ["10.1.1.0/24", "10.1.2.0/24"]
us_private_subnets = ["10.1.10.0/24", "10.1.11.0/24"]

# prometheus와 grafana 허용 및 arn과 sso group id 기입
enable_prometheus           = true
prometheus_workspace_arn    = ""
enable_grafana              = true
grafana_admin_sso_group_ids = [""]

# 사용할 route53의 도메인 주소 입력 및 zone 입력
route53_zone_name  = "example.com"
route53_cloudfront = "www.example.com"

# Google Cloud Console(APIs & Services > Credentials)에서 발급받는 OAuth 2.0 클라이언트.
# 승인된 리디렉션 URI에 https://<route53_cloudfront>/auth/callback을 등록해둬야 함.
# 둘 다 비워두면(기본값) Google 로그인 없이 이메일/비번 로그인만 동작함
google_oauth_client_id     = ""
google_oauth_client_secret = ""
